// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
   // 1. Increment current output
    Inc16(in=prevOut, out=incOut);

    // 2. Select between prevOut and incOut based on 'inc'
    Mux16(a=prevOut, b=incOut, sel=inc, out=mux1Out);

    // 3. Select between mux1Out and 'in' based on 'load'
    Mux16(a=mux1Out, b=in, sel=load, out=mux2Out);

    // 4. Select between mux2Out and 0 (false) based on 'reset'
    Mux16(a=mux2Out, b=false, sel=reset, out=mux3Out);

    // 5. Store in Register (load is always true to update state each cycle)
    Register(in=mux3Out, load=true, out=prevOut, out=out);
}